{
  "name": "xflow-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "temporal:dev": "dotenv -e .env.local -- ts-node src/temporal/worker.ts",
    "temporal:workflow": "dotenv -e .env.local -- ts-node src/temporal/start-workflow.ts",
    "temporal:worker1": "dotenv -e .env.local -- ts-node src/temporal/worker-stage1.ts",
    "temporal:worker2": "dotenv -e .env.local -- ts-node src/temporal/worker-stage2.ts",
    "temporal:worker3": "dotenv -e .env.local -- ts-node src/temporal/worker-stage3.ts",
    "temporal:worker1:ssl": "dotenv -e .env.local -- ts-node src/temporal/worker-stage1-ssl.ts",
    "temporal:worker2:ssl": "dotenv -e .env.local -- ts-node src/temporal/worker-stage2-ssl.ts",
    "temporal:worker3:ssl": "dotenv -e .env.local -- ts-node src/temporal/worker-stage3-ssl.ts",
    "temporal:worker3:client": "dotenv -e .env.local -- ts-node src/temporal/worker-stage3-client.ts",
    "temporal:test-connection": "dotenv -e .env.local -- node scripts/test-connection.js",
    "temporal:production-workers": "concurrently \"npm run temporal:worker1:ssl\" \"npm run temporal:worker2:ssl\"",
    "temporal:start-production": "npm run temporal:production-workers",
    "temporal:all-workers": "concurrently \"npm run temporal:worker1\" \"npm run temporal:worker2\" \"npm run temporal:worker3\"",
    "temporal:all-workers:ssl": "concurrently \"npm run temporal:worker1:ssl\" \"npm run temporal:worker2:ssl\" \"npm run temporal:worker3:ssl\""
  },
  "dependencies": {
    "@sendgrid/mail": "^7.7.0",
    "@temporalio/activity": "^1.8.0",
    "@temporalio/client": "^1.8.0",
    "@temporalio/worker": "^1.8.0",
    "@temporalio/workflow": "^1.8.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.0",
    "dotenv": "^17.2.0",
    "jsonwebtoken": "^9.0.2",
    "next": "14.0.0",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.10.0",
    "tailwindcss": "^3.3.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.51.0",
    "eslint-config-next": "14.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.0"
  }
}
